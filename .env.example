# TorrentFlix Environment Configuration
# Copy this file to .env and fill in your values
# All settings can also be configured via the Settings UI in the application

# ============================================================================
# API & METADATA SERVICES
# ============================================================================

# TMDB (The Movie Database) - Required for metadata enrichment
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Kinopoisk - Optional, for Russian movie ratings
# Get your token from: https://kinopoiskapiunofficial.tech/
KINOPOISK_API_TOKEN=your_kinopoisk_token_here

# ============================================================================
# QBITTORRENT CONFIGURATION
# ============================================================================

# Enable/disable qBittorrent integration
QBITTORRENT_ENABLED=true

# qBittorrent WebAPI connection details
QBITTORRENT_HOST=localhost
QBITTORRENT_PORT=5555
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# SSL/TLS configuration
QBITTORRENT_USE_SSL=false
QBITTORRENT_VERIFY_SSL=false

# Optional: Default category and tags for downloads
QBITTORRENT_CATEGORY=
QBITTORRENT_TAGS=

# Connection timeout in seconds
QBITTORRENT_TIMEOUT=10

# ============================================================================
# FILESYSTEM PATHS
# ============================================================================

# Directory where downloaded files will be stored
# Default: ~/Downloads/TorrentFlix
LIBRARY_PATH=~/Downloads/TorrentFlix

# Directory where qBittorrent saves incomplete downloads
# Default: ~/Downloads/qBittorrent
DOWNLOAD_PATH=~/Downloads/qBittorrent

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================

# Telegram Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEBOUNCE=300

# Email Notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
TO_EMAIL=

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# Search settings
SEARCH_LIMIT=100
SEARCH_TIMEOUT=30

# Download settings
MAX_CONCURRENT_DOWNLOADS=3

# Enabled indexers (comma-separated)
ENABLED_INDEXERS=monna

# ============================================================================
# PROXY CONFIGURATION (Optional)
# ============================================================================

# Enable SOCKS5 proxy for all connections
PROXY_ENABLED=false
PROXY_ADDRESS=127.0.0.1
PROXY_PORT=1080

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite database URL
DATABASE_URL=sqlite:///torrent_aggregator.db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ============================================================================
# LEGACY/DEPRECATED (Use Settings UI instead)
# ============================================================================

# These are kept for backward compatibility but should be configured via Settings UI
ADDRESS=127.0.0.1
PORT=1080
ADDRESS_PORT=127.0.0.1:1080
